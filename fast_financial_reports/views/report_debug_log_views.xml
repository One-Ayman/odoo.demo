<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fast_report_debug_log_list" model="ir.ui.view">
        <field name="name">fast.report.debug.log.list</field>
        <field name="model">fast.report.debug.log</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="report_type"/>
                <field name="query_id"/>
                <field name="user_id"/>
                <field name="sql_time_ms"/>
                <field name="processing_time_ms"/>
                <field name="total_time_ms"/>
                <field name="row_count"/>
                <field name="query_count"/>
            </tree>
        </field>
    </record>

    <record id="view_fast_report_debug_log_form" model="ir.ui.view">
        <field name="name">fast.report.debug.log.form</field>
        <field name="model">fast.report.debug.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <group>
                    <field name="create_date"/>
                    <field name="report_type"/>
                    <field name="query_id"/>
                    <field name="user_id"/>
                    <field name="company_ids" widget="many2many_tags"/>
                    <field name="sql_time_ms"/>
                    <field name="processing_time_ms"/>
                    <field name="total_time_ms"/>
                    <field name="row_count"/>
                    <field name="query_count"/>
                    <field name="filter_params" widget="text"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_fast_report_debug_log" model="ir.actions.act_window">
        <field name="name">Fast Financial Reports - Performance Log</field>
        <field name="res_model">fast.report.debug.log</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('group_fast_financial_reports_debug'))]"/>
    </record>

</odoo>
