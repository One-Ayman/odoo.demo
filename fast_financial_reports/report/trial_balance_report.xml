<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_trial_balance_landscape" model="report.paperformat">
        <field name="name">Fast Trial Balance (A4 Landscape)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_trial_balance" model="ir.actions.report">
        <field name="name">Trial Balance</field>
        <field name="model">fast.trial.balance.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fast_financial_reports.report_trial_balance_document</field>
        <field name="print_report_name">'Trial Balance - %s' % (object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_trial_balance_landscape"/>
    </record>

    <template id="report_trial_balance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- Current user's language direction (res.lang.direction: 'ltr'/'rtl') drives
                     the whole page - never a hardcoded language check. account_account.name is
                     a *translated* Char column (JSONB {lang: value}), already resolved to a
                     plain string server-side via _ffr_translated_sql() in the wizard's SQL, so
                     there is no translated-JSONB dict to leak here; only the static labels below
                     are translated, via this module's i18n/*.po files and Odoo's own QWeb
                     text-extraction. See report/partner_ledger_report.xml for the CSS notes this
                     template reuses verbatim (unpatched-Qt wkhtmltopdf quirks in this
                     environment: no CSS logical properties, RTL meta-line ordering, generous
                     fixed per-cell widths on the meta-line rather than relying on this engine's
                     auto intrinsic-width calculation). -->
                <t t-set="ffr_lang" t-value="doc.env['res.lang']._lang_get(doc.env.lang)"/>
                <t t-set="ffr_dir" t-value="(ffr_lang.direction if ffr_lang else False) or 'ltr'"/>
                <t t-set="ffr_rtl" t-value="ffr_dir == 'rtl'"/>
                <t t-set="ffr_align" t-value="'right' if ffr_rtl else 'left'"/>
                <t t-set="ffr_border_side" t-value="'right' if ffr_rtl else 'left'"/>
                <t t-call="web.external_layout">
                    <div class="page ffr-tb-page" t-att-dir="ffr_dir">
                        <style>
                            .ffr-tb-page { font-family: "Noto Naskh Arabic", "Noto Sans Arabic", "Lato", Arial, sans-serif; }
                            .ffr-tb-meta { font-size: 9px; color: #444; margin-top: 2px; border-collapse: collapse; table-layout: fixed; }
                            .ffr-tb-meta td { border: none; padding: 0; white-space: nowrap; }
                            .ffr-tb-meta td.ffr-label { color: #777; }
                            .ffr-tb-table { table-layout: fixed; width: 100%; border-collapse: collapse; margin-top: 8px; }
                            .ffr-tb-table col.ffr-col-code { width: 9%; }
                            .ffr-tb-table col.ffr-col-name { width: auto; }
                            .ffr-tb-table col.ffr-col-num { width: 11.5%; }
                            .ffr-tb-table th, .ffr-tb-table td { border: 0.5pt solid #b9c2d0; padding: 4px 6px; vertical-align: top; }
                            .ffr-tb-table thead th { background: #2c3e6b; color: #fff; font-size: 8.5pt; text-align: center; }
                            .ffr-tb-table thead tr.ffr-sub th { background: #3f5490; font-size: 8pt; font-weight: 500; }
                            .ffr-tb-table tbody td.ffr-name { word-wrap: break-word; overflow-wrap: break-word; }
                            .ffr-tb-table tbody td.ffr-num { text-align: center; direction: ltr; white-space: nowrap; }
                            .ffr-tb-table tbody tr:nth-child(even) { background: #f4f6fb; }
                            .ffr-tb-table tfoot td.ffr-num { font-weight: 700; text-align: center; direction: ltr; background: #e7ebf5; }
                        </style>

                        <h2><span>Trial Balance</span></h2>

                        <!-- Filter meta-line: dir="ltr" wrapper with cells pre-ordered so the
                             final reading order is correct in both directions, each cell given
                             a generous static width (table-layout:fixed) rather than relying on
                             this engine's auto intrinsic-width calculation, which was found to
                             miscompute box boundaries next to an RTL/LTR content change even
                             with per-cell dir set. -->
                        <table class="ffr-tb-meta" dir="ltr" style="margin-left:auto;">
                            <tr t-if="ffr_rtl">
                                <td t-attf-style="text-align: right; padding-left: 16px; width: 220px;">
                                    <span t-if="doc.posted_only">Posted Entries Only</span>
                                    <span t-else="">All Entries (Posted and Draft)</span>
                                </td>
                                <td t-attf-style="text-align: right; padding-left: 4px; width: 260px;">
                                    <span t-esc="', '.join(doc.company_ids.mapped('name'))"/>
                                </td>
                                <td class="ffr-label" t-attf-style="text-align: right; padding-left: 16px; width: 90px;">
                                    <span>Companies:</span>
                                </td>
                                <td dir="ltr" t-attf-style="text-align: right; padding-left: 4px; direction: ltr; width: 170px;">
                                    <span t-field="doc.date_from"/> &#8211; <span t-field="doc.date_to"/>
                                </td>
                                <td class="ffr-label" t-attf-style="text-align: right; width: 70px;">
                                    <span>Period:</span>
                                </td>
                            </tr>
                            <tr t-else="">
                                <td class="ffr-label" t-attf-style="text-align: left; padding-right: 4px; width: 50px;">
                                    <span>Period:</span>
                                </td>
                                <td dir="ltr" t-attf-style="text-align: left; padding-right: 16px; width: 170px;">
                                    <span t-field="doc.date_from"/> &#8211; <span t-field="doc.date_to"/>
                                </td>
                                <td class="ffr-label" t-attf-style="text-align: left; padding-right: 4px; width: 90px;">
                                    <span>Companies:</span>
                                </td>
                                <td t-attf-style="text-align: left; padding-right: 16px; width: 260px;">
                                    <span t-esc="', '.join(doc.company_ids.mapped('name'))"/>
                                </td>
                                <td t-attf-style="text-align: left; width: 220px;">
                                    <span t-if="doc.posted_only">Posted Entries Only</span>
                                    <span t-else="">All Entries (Posted and Draft)</span>
                                </td>
                            </tr>
                        </table>

                        <table class="ffr-tb-table" t-attf-style="direction: #{ffr_dir};">
                            <colgroup>
                                <col class="ffr-col-code"/><col class="ffr-col-name"/>
                                <col class="ffr-col-num"/><col class="ffr-col-num"/>
                                <col class="ffr-col-num"/><col class="ffr-col-num"/>
                                <col class="ffr-col-num"/><col class="ffr-col-num"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="2" t-attf-style="text-align: #{ffr_align};"><span>Account Code</span></th>
                                    <th rowspan="2" t-attf-style="text-align: #{ffr_align};"><span>Account Name</span></th>
                                    <th colspan="2" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Opening Balance</span></th>
                                    <th colspan="2" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Period</span></th>
                                    <th colspan="2" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Ending Balance</span></th>
                                </tr>
                                <tr class="ffr-sub">
                                    <th t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Debit</span></th><th><span>Credit</span></th>
                                    <th t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Debit</span></th><th><span>Credit</span></th>
                                    <th t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span>Debit</span></th><th><span>Credit</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td class="ffr-name" t-attf-style="text-align: #{ffr_align};"><span t-esc="line.account_code"/></td>
                                    <td class="ffr-name" t-attf-style="text-align: #{ffr_align};" t-out="doc._ffr_wrap_html_lines(line.account_name)"/>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="line.opening_debit"/></td>
                                    <td class="ffr-num"><span t-field="line.opening_credit"/></td>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="line.period_debit"/></td>
                                    <td class="ffr-num"><span t-field="line.period_credit"/></td>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="line.ending_debit"/></td>
                                    <td class="ffr-num"><span t-field="line.ending_credit"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" t-attf-style="font-weight: 700; text-align: #{ffr_align};"><span>Total</span></td>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="doc.total_opening_debit"/></td>
                                    <td class="ffr-num"><span t-field="doc.total_opening_credit"/></td>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="doc.total_period_debit"/></td>
                                    <td class="ffr-num"><span t-field="doc.total_period_credit"/></td>
                                    <td class="ffr-num" t-attf-style="border-#{ffr_border_side}: 1.5pt solid #2c3e6b;"><span t-field="doc.total_ending_debit"/></td>
                                    <td class="ffr-num"><span t-field="doc.total_ending_credit"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
