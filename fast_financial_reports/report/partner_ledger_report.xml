<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_partner_ledger" model="ir.actions.report">
        <field name="name">Partner Ledger</field>
        <field name="model">fast.partner.ledger.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fast_financial_reports.report_partner_ledger_document</field>
        <field name="print_report_name">'Partner Ledger - %s' % (object.date_to)</field>
    </record>

    <template id="report_partner_ledger_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.internal_layout">
                    <div class="page">
                        <h2>Partner Ledger</h2>
                        <p>
                            Period: <span t-esc="doc.date_from"/> to <span t-esc="doc.date_to"/>
                            (page <span t-esc="doc.page"/> / <span t-esc="doc.total_page_count"/>)
                        </p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <th class="text-end">Opening Balance</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <th class="text-end">Closing Balance</th>
                                    <th class="text-end">Entries</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-esc="line.partner_name"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.opening_balance"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.period_debit"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.period_credit"/></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.closing_balance"/></td>
                                    <td class="text-end"><span t-esc="line.entry_count"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
