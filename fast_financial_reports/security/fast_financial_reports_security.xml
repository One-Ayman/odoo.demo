<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Technical / debug group: only users explicitly granted this
             (or, by default, Administrators) can see the performance debug
             log. Ordinary accounting users never see it, per spec. -->
