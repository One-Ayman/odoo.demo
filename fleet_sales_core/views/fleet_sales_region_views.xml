<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_sales_region_list" model="ir.ui.view">
        <field name="name">fleet.sales.region.list</field>
        <field name="model">fleet.sales.region</field>
        <field name="arch" type="xml">
            <list string="Regions">
                <field name="code"/>
                <field name="name"/>
                <field name="manager_id"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_sales_region_form" model="ir.ui.view">
        <field name="name">fleet.sales.region.form</field>
        <field name="model">fleet.sales.region</field>
        <field name="arch" type="xml">
            <form string="Region">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Central Region"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"
                                   domain="[('all_group_ids', 'in', %(fleet_sales_core.group_fleet_sales_regional_manager)d)]"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_sales_region" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">fleet.sales.region</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first region</p>
        </field>
    </record>
</odoo>
