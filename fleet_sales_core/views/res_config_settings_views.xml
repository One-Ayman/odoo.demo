<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fleet_sales" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fleet.sales</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Field Sales" string="Field Sales" name="fleet_sales"
                     groups="fleet_sales_core.group_fleet_sales_general_manager">
                    <block title="Customer Activity" name="fleet_sales_activity_setting_container">
                        <setting id="fleet_sales_inactive_setting"
                                 help="Used to flag POS locations that haven't ordered in a while">
                            <field name="fleet_sales_inactive_warning_days"/>
                            <span class="o_form_label ms-2">days without an order: show a warning</span>
                            <br/>
                            <field name="fleet_sales_inactive_days"/>
                            <span class="o_form_label ms-2">days without an order: flag as inactive</span>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
