<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_fleet_sales_field_ops" model="ir.ui.view">
        <field name="name">res.partner.form.fleet.sales.field.ops</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Field Visit Settings">
                    <group>
                        <field name="enforce_visit_geofence"/>
                        <field name="visit_geofence_radius"
                               invisible="not enforce_visit_geofence"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
