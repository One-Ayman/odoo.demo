<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_sales_pos_request_list" model="ir.ui.view">
        <field name="name">fleet.sales.pos.request.list</field>
        <field name="model">fleet.sales.pos.request</field>
        <field name="arch" type="xml">
            <list string="New POS Location Requests">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="requested_by"/>
                <field name="region_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"
                       decoration-info="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_sales_pos_request_form" model="ir.ui.view">
        <field name="name">fleet.sales.pos.request.form</field>
        <field name="model">fleet.sales.pos.request</field>
        <field name="arch" type="xml">
            <form string="New POS Location Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'submitted'"
                            groups="fleet_sales_core.group_fleet_sales_supervisor"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"
                            groups="fleet_sales_core.group_fleet_sales_supervisor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_created_location" type="object"
                                class="oe_stat_button" icon="fa-map-marker"
                                invisible="not created_location_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">POS Location</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Jeddah Corniche Kiosk" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="street" readonly="state != 'draft'"/>
                            <field name="city" readonly="state != 'draft'"/>
                            <field name="latitude" readonly="state != 'draft'"/>
                            <field name="longitude" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="sector_id" readonly="state != 'draft'"/>
                            <field name="region_id" readonly="state != 'draft'"/>
                            <field name="salesman_id" readonly="state != 'draft'"/>
                            <field name="visit_frequency_days" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Decision" invisible="state not in ('approved', 'rejected')">
                        <field name="approver_id" readonly="1"/>
                        <field name="decision_date" readonly="1"/>
                        <field name="reason" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_sales_pos_request" model="ir.actions.act_window">
        <field name="name">New POS Location Requests</field>
        <field name="res_model">fleet.sales.pos.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Submit a new POS location request</p>
        </field>
    </record>
</odoo>
