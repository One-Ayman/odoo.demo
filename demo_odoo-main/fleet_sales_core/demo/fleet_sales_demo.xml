<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regions -->
        <record id="demo_region_central" model="fleet.sales.region">
            <field name="name">Central Region</field>
            <field name="code">CENTRAL</field>
        </record>
        <record id="demo_region_western" model="fleet.sales.region">
            <field name="name">Western Region</field>
            <field name="code">WEST</field>
        </record>
        <record id="demo_region_eastern" model="fleet.sales.region">
            <field name="name">Eastern Region</field>
            <field name="code">EAST</field>
        </record>

        <!-- Sectors -->
        <record id="demo_sector_grocery" model="fleet.sales.sector">
            <field name="name">Grocery</field>
            <field name="code">GROC</field>
        </record>
        <record id="demo_sector_horeca" model="fleet.sales.sector">
            <field name="name">HORECA</field>
            <field name="code">HORECA</field>
        </record>
        <record id="demo_sector_pharmacy" model="fleet.sales.sector">
            <field name="name">Pharmacy</field>
            <field name="code">PHARM</field>
        </record>
        <record id="demo_sector_convenience" model="fleet.sales.sector">
            <field name="name">Convenience Store</field>
            <field name="code">CONV</field>
        </record>
        <record id="demo_sector_bakery" model="fleet.sales.sector">
            <field name="name">Bakery</field>
            <field name="code">BAKE</field>
        </record>

        <!-- Users: General Manager -->
        <record id="demo_user_gm" model="res.users">
            <field name="name">Abdullah Al-Zahrani</field>
            <field name="login">gm@fleetsales.demo</field>
            <field name="email">gm@fleetsales.demo</field>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_general_manager')])]"/>
        </record>

        <!-- Users: Finance -->
        <record id="demo_user_finance" model="res.users">
            <field name="name">Nourah Al-Qahtani</field>
            <field name="login">finance@fleetsales.demo</field>
            <field name="email">finance@fleetsales.demo</field>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_finance')])]"/>
        </record>

        <!-- Users: Regional Managers (one per region) -->
        <record id="demo_user_rm_central" model="res.users">
            <field name="name">Faisal Al-Harbi</field>
            <field name="login">rm.central@fleetsales.demo</field>
            <field name="email">rm.central@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_central"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_regional_manager')])]"/>
        </record>

        <!-- Users: Supervisor, reporting to the Central Regional Manager -->
        <record id="demo_user_supervisor_central" model="res.users">
            <field name="name">Khalid Al-Otaibi</field>
            <field name="login">supervisor.central@fleetsales.demo</field>
            <field name="email">supervisor.central@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_central"/>
            <field name="supervisor_id" ref="demo_user_rm_central"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_supervisor')])]"/>
        </record>

        <!-- Users: Salesmen, reporting to the Central Supervisor -->
        <record id="demo_user_salesman_1" model="res.users">
            <field name="name">Omar Al-Shammari</field>
            <field name="login">salesman1@fleetsales.demo</field>
            <field name="email">salesman1@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_central"/>
            <field name="supervisor_id" ref="demo_user_supervisor_central"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_salesman')])]"/>
        </record>
        <record id="demo_user_salesman_2" model="res.users">
            <field name="name">Yousef Al-Dosari</field>
            <field name="login">salesman2@fleetsales.demo</field>
            <field name="email">salesman2@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_central"/>
            <field name="supervisor_id" ref="demo_user_supervisor_central"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_salesman')])]"/>
        </record>

        <!-- Users: a second, independent region, so a Regional Manager's
             isolation can actually be exercised in UAT (Central RM must
             never see Western's team or requests). -->
        <record id="demo_user_supervisor_western" model="res.users">
            <field name="name">Layla Al-Harthi</field>
            <field name="login">supervisor.western@fleetsales.demo</field>
            <field name="email">supervisor.western@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_western"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_supervisor')])]"/>
        </record>
        <record id="demo_user_salesman_western" model="res.users">
            <field name="name">Faris Al-Qahtani</field>
            <field name="login">salesman.western@fleetsales.demo</field>
            <field name="email">salesman.western@fleetsales.demo</field>
            <field name="region_id" ref="demo_region_western"/>
            <field name="supervisor_id" ref="demo_user_supervisor_western"/>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_fleet_sales_salesman')])]"/>
        </record>

        <!-- Sample requests: one approved, one still pending, one from the
             other region entirely -->
        <record id="demo_customer_request_approved" model="fleet.sales.customer.request">
            <field name="name">Al Rawabi Grocery</field>
            <field name="vat">300012345600003</field>
            <field name="mobile">0501234567</field>
            <field name="sector_id" ref="demo_sector_grocery"/>
            <field name="region_id" ref="demo_region_central"/>
            <field name="proposed_salesman_id" ref="demo_user_salesman_1"/>
            <field name="requested_by" ref="demo_user_salesman_1"/>
        </record>

        <record id="demo_customer_request_pending" model="fleet.sales.customer.request">
            <field name="name">Al Waha Mini Market</field>
            <field name="vat">300098765400003</field>
            <field name="mobile">0559876543</field>
            <field name="sector_id" ref="demo_sector_convenience"/>
            <field name="region_id" ref="demo_region_central"/>
            <field name="proposed_salesman_id" ref="demo_user_salesman_2"/>
            <field name="requested_by" ref="demo_user_salesman_2"/>
        </record>

        <record id="demo_customer_request_western" model="fleet.sales.customer.request">
            <field name="name">Jeddah Fresh Mart</field>
            <field name="vat">300077788800003</field>
            <field name="mobile">0533445566</field>
            <field name="sector_id" ref="demo_sector_grocery"/>
            <field name="region_id" ref="demo_region_western"/>
            <field name="proposed_salesman_id" ref="demo_user_salesman_western"/>
            <field name="requested_by" ref="demo_user_salesman_western"/>
        </record>

        <!-- Exercise the real workflow: submit all three, approve only the first -->
        <function model="fleet.sales.customer.request" name="action_submit"
                   eval="[[ref('demo_customer_request_approved'), ref('demo_customer_request_pending'), ref('demo_customer_request_western')]]"/>
        <function model="fleet.sales.customer.request" name="action_approve"
                   eval="[[ref('demo_customer_request_approved')]]"/>

        <!-- An existing customer (not from today's request flow) with a
             pending POS Location request, for the POS-request UAT scenario -->
        <record id="demo_partner_al_fanar" model="res.partner">
            <field name="name">Al Fanar Trading Co.</field>
            <field name="is_company" eval="True"/>
            <field name="vat">300055566600003</field>
            <field name="mobile">0512223344</field>
            <field name="sector_id" ref="demo_sector_horeca"/>
            <field name="region_id" ref="demo_region_central"/>
            <field name="salesman_id" ref="demo_user_salesman_1"/>
        </record>

        <record id="demo_pos_request_pending" model="fleet.sales.pos.request">
            <field name="name">Al Fanar - Olaya Branch</field>
            <field name="customer_id" ref="demo_partner_al_fanar"/>
            <field name="street">Olaya Street</field>
            <field name="city">Riyadh</field>
            <field name="latitude">24.6980</field>
            <field name="longitude">46.6850</field>
            <field name="sector_id" ref="demo_sector_horeca"/>
            <field name="region_id" ref="demo_region_central"/>
            <field name="salesman_id" ref="demo_user_salesman_1"/>
            <field name="requested_by" ref="demo_user_salesman_1"/>
        </record>
        <function model="fleet.sales.pos.request" name="action_submit"
                   eval="[[ref('demo_pos_request_pending')]]"/>

    </data>
</odoo>
