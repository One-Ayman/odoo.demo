<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fleet_sales_field_ops.GpsCaptureField" owl="1">
        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    t-on-click="captureLocation">
                <i class="fa fa-crosshairs me-1"/>Capture My Location
            </button>
            <span t-if="isCaptured" class="text-success small">
                <i class="fa fa-check-circle me-1"/>Captured
                (<t t-esc="latitude.toFixed(5)"/>, <t t-esc="longitude.toFixed(5)"/>)
            </span>
            <span t-else="" class="text-muted small">Not captured yet</span>
        </div>
    </t>
</templates>
