<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_fleet_sales_field_ops" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.fleet.sales.field.ops</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fleet_sales_core.res_config_settings_view_form_fleet_sales"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='fleet_sales']" position="inside">
                <block title="Field Collections" name="fleet_sales_field_ops_setting_container">
                    <setting id="fleet_sales_mada_journal_setting"
                             help="Bank journal used for Mada collections registered from field visits. These are always created as draft vouchers pending Finance review, never posted automatically.">
                        <field name="fleet_sales_mada_journal_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
