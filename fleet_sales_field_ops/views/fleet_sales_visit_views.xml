<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_sales_visit_form" model="ir.ui.view">
        <field name="name">fleet.sales.visit.form</field>
        <field name="model">fleet.sales.visit</field>
        <field name="arch" type="xml">
            <form string="Field Visit">
                <header>
                    <button name="action_check_in" type="object" string="Check In"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_order" type="object" string="Start Order"
                            invisible="state != 'checked_in' or sale_order_id"/>
                    <button name="action_process_sale" type="object"
                            string="Confirm, Deliver &amp; Invoice" class="oe_highlight"
                            invisible="not sale_order_id or state == 'closed'"/>
                    <button name="action_register_cash_payment" type="object"
                            string="Collect Cash" invisible="state == 'draft'"/>
                    <button name="action_register_mada_payment" type="object"
                            string="Collect Mada" invisible="state == 'draft'"/>
                    <button name="action_close_visit" type="object"
                            string="Close Visit" invisible="state != 'checked_in'"
                            confirm="Close this visit? This can be done with or without a sale or a collection."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,checked_in,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_order" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not order_count">
                            <field name="order_count" widget="statinfo" string="Order"/>
                        </button>
                        <button name="action_view_deliveries" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not delivery_count">
                            <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_count">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not payment_count">
                            <field name="payment_count" widget="statinfo" string="Collections"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Successful" bg_color="text-bg-success"
                            invisible="not is_successful or state != 'closed'"/>
                    <widget name="web_ribbon" title="Unsuccessful" bg_color="text-bg-danger"
                            invisible="is_successful or state != 'closed'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="salesman_id"/>
                            <field name="region_id"/>
                            <field name="sector_id"/>
                        </group>
                        <group>
                            <field name="check_in_datetime" readonly="1"/>
                            <field name="check_in_latitude"
                                   invisible="state != 'draft'"/>
                            <field name="check_in_longitude"
                                   invisible="state != 'draft'"/>
                            <field name="distance_to_customer" readonly="1"
                                   invisible="not check_in_datetime"/>
                            <field name="credit_warning" invisible="not credit_warning"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shelf Photos / Attachments">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Customer On-Hand Inventory" name="customer_stock">
                            <field name="customer_stock_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_sales_visit_list" model="ir.ui.view">
        <field name="name">fleet.sales.visit.list</field>
        <field name="model">fleet.sales.visit</field>
        <field name="arch" type="xml">
            <list string="Field Visits">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="salesman_id"/>
                <field name="region_id"/>
                <field name="state"/>
                <field name="is_successful" widget="boolean_toggle"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_sales_visit_search" model="ir.ui.view">
        <field name="name">fleet.sales.visit.search</field>
        <field name="model">fleet.sales.visit</field>
        <field name="arch" type="xml">
            <search string="Field Visits">
                <field name="partner_id"/>
                <field name="salesman_id"/>
                <field name="region_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Closed" name="closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Salesman" name="group_salesman" context="{'group_by': 'salesman_id'}"/>
                <filter string="Region" name="group_region" context="{'group_by': 'region_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_fleet_sales_visit_pivot" model="ir.ui.view">
        <field name="name">fleet.sales.visit.pivot</field>
        <field name="model">fleet.sales.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Report">
                <field name="salesman_id" type="row"/>
                <field name="is_successful" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_fleet_sales_visit_graph" model="ir.ui.view">
        <field name="name">fleet.sales.visit.graph</field>
        <field name="model">fleet.sales.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit Report" type="bar">
                <field name="salesman_id"/>
                <field name="is_successful"/>
            </graph>
        </field>
    </record>

    <record id="action_fleet_sales_visit" model="ir.actions.act_window">
        <field name="name">Field Visits</field>
        <field name="res_model">fleet.sales.visit</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="context">{'search_default_group_salesman': 1}</field>
    </record>

    <record id="action_fleet_sales_visit_report" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">fleet.sales.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '=', 'closed')]</field>
        <field name="context">{'search_default_group_success': 1}</field>
    </record>

</odoo>
